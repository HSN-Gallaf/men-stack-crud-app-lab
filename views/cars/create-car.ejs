<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create New Car</title>
  </head>
  <body>
    <%- include('../partials/navbar.ejs') %>

    <h1>Add a Car</h1>
    <form action="/cars" method="POST">
      <label for="name">Car Name</label>
      <input id="name" type="text" name="name" /><br /><br />

      <label for="model">Car Model</label>
      <input id="model" type="text" name="model" /><br /><br />

      <label for="isElectric">Is Car Electric</label>
      <input id="isElectric" type="checkbox" name="isElectric" /><br /><br />

      <!-- <label for="postDate">Car Name</label>
      <input id="postDate" type="text" name="postDate" /><br /><br /> -->

      <label>Features:</label><br />

      <label>
        <input type="checkbox" name="features" value="backup_camera" /> Backup
        Camera </label
      ><br />
      <label>
        <input type="checkbox" name="features" value="sunroof" />
        Sunroof </label
      ><br />
      <label>
        <input type="checkbox" name="features" value="leather" /> Leather Seats </label
      ><br /><br />

      <label for="image">Car Image</label>
      <input id="image" type="text" name="image" /><br /><br />

      <button type="submit">Add Car</button>
    </form>
  </body>
</html>
