<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Car Details</title>
  </head>
  <body>
    <h1><%= car.name %></h1>

    <p><%= car.model  %></p>

    <% if(car.isElectric) {%>
        <p>The Car is Electric</p>
        <% } else {%> 
        <p>The Car Is Not Electric</p> 
        <% }  %> 

    <p><%= car.postDate  %></p>

    <ul>
    <% for(let feature of car.features) { %>
        <p><%= feature %></p>
        <% } %>
    </ul>
        <!-- Add Image -->

        <form action="/cars/<%=car._id  %>/delete?_method=DELETE" method="POST">
          <a href="/cars/<%= car._id  %>/edit">Edit <%= car.name %></a>
            <button type="submit">Delete <%= car.name %></button>
        </form>
  </body>
</html>
