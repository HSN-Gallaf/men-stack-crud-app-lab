<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Car List</title>
  </head>
  <body>
    <%- include('../partials/navbar.ejs') %>

    <h1>Car List</h1>
    <ul>
      <% for(let car of cars) { %>
        <li><a href="/cars/<%=car._id  %>"><%= car.name  %></a></li>
      <% } %>
    </ul>
  </body>
</html>
